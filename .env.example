# SatQuery AI — Environment Configuration
# Copy this file to .env and fill in your API keys

# AI Provider: "gemini" or "openai"
AI_PROVIDER=gemini

# Google Gemini API Key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# OpenAI API Key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Server port
PORT=3001

# OpenStreetMap Overpass API (public endpoint, no API key needed)
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Maximum AOI area (in km²) allowed for detailed OSM vector analysis
MAX_OSM_AOI_KM2=25

# Copernicus / Sentinel Hub API Credentials (for real Sentinel-2 satellite imagery acquisition)
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

